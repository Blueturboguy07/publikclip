{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "publikclip",
  "version": "0.2.9",
  "identifier": "com.publikhq.publikclip",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "node scripts/prepare-resources.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.publikclip/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "resources"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY1RTA1MTVDNzc5MTJCRDAKUldUUUs1RjNYRkhnOWRTQ2UwaGJ5Vm5vTTRwV2d5NzNNZEQrWWYxSU1abnRnWEthc3FkWVJjWXYK",
      "endpoints": ["https://publikhq.com/api/updates/publikclip/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
